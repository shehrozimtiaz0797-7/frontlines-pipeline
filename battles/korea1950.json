:1.0},{"lat":35.7,"lon":128.3,"control":[["1950-06-25","A"],["1950-08-04","B"],["1950-09-21","A"]],"weight":1.0},{"lat":35.4,"lon":128.2,"control":[["1950-06-25","A"],["1950-08-01","B"],["1950-09-24","A"]],"weight":1.0}],"events":[{"date":"1950-06-25","text":"North Korean forces cross the 38th parallel. Kaesong falls within hours.","arrow":{"from":[38.25,126.6],"to":[37.85,126.75],"side":"B"}},{"date":"1950-06-28","text":"Seoul falls three days into the war.","arrow":{"from":[37.95,127.1],"to":[37.62,127.0],"side":"B"}},{"date":"1950-07-05","text":"Task Force Smith, the first US ground unit in the war, is pushed back at Osan.","arrow":null},{"date":"1950-07-20","text":"Taejon falls. The US 24th Division's commander, Gen. William Dean, goes missing.","arrow":{"from":[36.75,127.25],"to":[36.4,127.38],"side":"B"}},{"date":"1950-08-04","text":"UN forces pull back behind the Naktong River. The Pusan Perimeter is formed.","arrow":null},{"date":"1950-09-01","text":"Great Naktong Offensive: North Korea's last all-out attack on the perimeter.","arrow":{"from":[35.47,128.25],"to":[35.45,128.55],"side":"B"}},{"date":"1950-09-15","text":"Operation Chromite: US Marines land at Inchon, far behind North Korean lines.","arrow":{"from":[37.35,126.25],"to":[37.45,126.65],"side":"A"}},{"date":"1950-09-16","text":"The US Eighth Army begins its breakout from the Pusan Perimeter.","arrow":{"from":[35.95,128.55],"to":[36.15,128.15],"side":"A"}},{"date":"1950-09-27","text":"Eighth Army and X Corps meet near Osan, cutting off the North Korean forces in the south.","arrow":{"from":[36.75,127.2],"to":[37.1,127.07],"side":"A"}},{"date":"1950-09-29","text":"Seoul is handed back to President Syngman Rhee's government in a ceremony.","arrow":null}],"short_center":[127.75,36.25],"short_bbox":[125.0,32.4,130.2,39.2],"long_bbox":[124.4,33.5,130.6,39.1],"thumb_date":"1950-09-01","thumb_text":"Korea 1950","parts":{"b":{"from":"1950-09-15","to":"1950-09-29","title":"15 Days That Turned the Korean War","subtitle":"Inchon and the breakout, September 1950"}},"yt":{"long_title":"Korean War 1950: Every Day on the Map, from the Invasion to Inchon","short_a_title":"Korean War 1950 in 55 seconds: from the edge of defeat to Inchon 🗺️","short_b_title":"How one landing at Inchon flipped the Korean War in 15 days 🗺️","about":"On 25 June 1950 the North Korean army crossed the 38th parallel. Seoul fell on 28 June, the first US troops were pushed back at Osan on 5 July and Taejon fell on 20 July. By 4 August the South Korean and UN forces held only a corner of the peninsula behind the Naktong River, the Pusan Perimeter. They held it through the Great Naktong Offensive in early September. On 15 September US Marines landed at Inchon, the Eighth Army broke out of the perimeter from 16 September, the two forces met near Osan on 27 September, Seoul was cleared on 28 September and handed back to the South Korean government on 29 September.","tags":["Korean War","Korean War 1950","Pusan Perimeter","Battle of Inchon","Operation Chromite","Seoul","Cold War","history map","day by day","front line map","MacArthur","Naktong River"],"hashtag":"koreanwar"}}